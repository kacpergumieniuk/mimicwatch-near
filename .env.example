# All optional. Nothing here is secret: keys live in .mimicwatch-local/ (gitignored), never in env files.
# Registry contract to query (default: the testnet deployment in .mimicwatch-local/testnet.json)
MIMICWATCH_REGISTRY=registry.mimicwatch-e7iig5g5.testnet
# RPC used for registry views
MIMICWATCH_RPC=https://test.rpc.fastnear.com
# Where published evidence files are served from (the public repo)
MIMICWATCH_EVIDENCE_BASE=https://github.com/kacpergumieniuk/mimicwatch-near/blob/main
